Preload libproj, and point PROJ at the database, before the extensions.

flet-libproj ships a shared libproj.dylib for iOS, the same image libgdal
links, so pyproj and the GDAL consumers resolve ONE PROJ.

Delivery first. On iOS, flet moves each extension and each dylib into its own
framework, rewrites the extensions' @rpath links to match, and leaves a .fwork
marker in opt/lib. This shim also preloads libproj RTLD_GLOBAL before the first
extension import -- from opt/lib/libproj.dylib, or by reading
opt/lib/libproj.fwork and loading the framework binary it names -- so every
extension binds the one loaded image.

Then PROJ_DATA. On iOS flet-libproj's opt/share/proj is a real directory inside
the app, and pyproj's get_data_dir() reaches it through PROJ_DATA, so the shim
sets PROJ_DATA and PROJ_LIB to it. On Android that tree never reaches
site-packages, so the database travels in this package's own proj_dir
(PROJ_WHEEL, on disk once the app extracts pyproj), which get_data_dir() reads
before PROJ_DATA; the shim exports that path as well. It runs this early
because get_data_dir() reads the variable when `import pyproj` creates the
first context, and caches the directory it finds. A PROJ_DATA or PROJ_LIB the
app already set is left alone.

The preload half is inert on Android, where DT_NEEDED resolves the .so by
basename out of jniLibs, and both halves are inert on a desktop.

--- a/pyproj/__init__.py
+++ b/pyproj/__init__.py
@@ -29,6 +29,90 @@
 SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
 """
 
+# mobile-forge (iOS): the extensions below link libproj through @rpath. flet
+# moves each extension and each dylib into its own framework and leaves a
+# "<name>.fwork" marker holding the app-relative path. Preload libproj
+# RTLD_GLOBAL first, so every extension binds the one loaded image, following
+# the marker where flet left one. No-op on Android, where DT_NEEDED resolves
+# the .so by basename out of jniLibs, and on desktop, where there is no opt/lib
+# to find.
+try:
+    import ctypes as _mf_ctypes
+    import os as _mf_os
+
+    _mf_optlib = _mf_os.path.join(
+        _mf_os.path.dirname(_mf_os.path.dirname(_mf_os.path.abspath(__file__))),
+        "opt",
+        "lib",
+    )
+    for _mf_base in ("libproj",):
+        _mf_dylib = _mf_os.path.join(_mf_optlib, _mf_base + ".dylib")
+        if _mf_os.path.exists(_mf_dylib):
+            try:
+                _mf_ctypes.CDLL(_mf_dylib, mode=_mf_ctypes.RTLD_GLOBAL)
+            except OSError:
+                pass
+            continue
+        _mf_fwork = _mf_os.path.join(_mf_optlib, _mf_base + ".fwork")
+        if not _mf_os.path.exists(_mf_fwork):
+            continue
+        _mf_rel = open(_mf_fwork).read().strip()
+        _mf_dir = _mf_optlib
+        for _ in range(12):
+            _mf_dir = _mf_os.path.dirname(_mf_dir)
+            _mf_candidate = _mf_os.path.join(_mf_dir, _mf_rel)
+            if _mf_os.path.exists(_mf_candidate):
+                try:
+                    _mf_ctypes.CDLL(_mf_candidate, mode=_mf_ctypes.RTLD_GLOBAL)
+                except OSError:
+                    pass
+                break
+except Exception:
+    pass
+
+# mobile-forge: point PROJ at whichever database reached this device, so EPSG
+# codes resolve. get_data_dir() reads PROJ_DATA when this import creates the
+# first context and caches the directory it finds, so this runs before that.
+# Only set when the app has set neither PROJ_DATA nor PROJ_LIB.
+#
+# Two places it can be. On iOS flet-libproj's opt/share/proj is a real
+# directory inside the app, and this variable is how get_data_dir() finds it.
+# On Android that tree never reaches site-packages, so the database travels in
+# this package's own proj_dir, on disk when the app extracts pyproj; there
+# get_data_dir() reads proj_dir before PROJ_DATA.
+try:
+    import os as _mf_os2
+
+    if not _mf_os2.environ.get("PROJ_DATA") and not _mf_os2.environ.get("PROJ_LIB"):
+        _mf_roots = [
+            _mf_os2.path.join(
+                _mf_os2.path.dirname(
+                    _mf_os2.path.dirname(_mf_os2.path.abspath(__file__))
+                ),
+                "opt", "share", "proj",
+            )
+        ]
+        try:
+            from importlib.util import find_spec as _mf_find
+
+            _mf_spec = _mf_find("pyproj")
+            if _mf_spec is not None and _mf_spec.origin:
+                _mf_roots.append(
+                    _mf_os2.path.join(
+                        _mf_os2.path.dirname(_mf_spec.origin),
+                        "proj_dir", "share", "proj",
+                    )
+                )
+        except Exception:
+            pass
+        for _mf_root in _mf_roots:
+            if _mf_os2.path.exists(_mf_os2.path.join(_mf_root, "proj.db")):
+                _mf_os2.environ["PROJ_DATA"] = _mf_root
+                _mf_os2.environ["PROJ_LIB"] = _mf_root
+                break
+except Exception:
+    pass
+
 import warnings
 
 import pyproj.network
