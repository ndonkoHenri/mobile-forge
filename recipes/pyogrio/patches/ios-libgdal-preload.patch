Preload libproj + libgdal, and point PROJ at the database, before the extensions.

flet-libgdal ships a shared libgdal.dylib for iOS which links flet-libproj's
shared libproj.dylib, so gdal, fiona, rasterio and pyogrio resolve ONE GDAL, and
they and pyproj ONE PROJ.

Delivery first: on iOS, flet moves each extension and each dylib into its own
framework, rewrites the extensions' @rpath links to match, and leaves a
"<name>.fwork" marker in opt/lib holding the app-relative path. The shim loads
libproj, then libgdal, RTLD_GLOBAL before the first extension import -- from
opt/lib, or through the marker -- so every extension binds the one loaded image.
Whether flet's framework relocation resolves them without it is untested.

Then PROJ_DATA, which is where the platforms diverge. On iOS flet-libproj's
opt/share/proj is a real directory inside the app, so pointing PROJ at it makes
EPSG codes resolve for every consumer at once -- they share the instance. On
Android that tree never reaches site-packages at all, so the database travels
inside pyproj instead (extracted to disk by extract_packages); the shim finds it
through find_spec, without importing pyproj, and falls through quietly when
pyproj is absent. It has to be an environment variable set before the first
import rather than an API call, because PROJ reads it when it creates its first
context. An app that sets its own PROJ_DATA or PROJ_LIB still wins.

The preload half is a no-op on Android, where DT_NEEDED resolves the .so by
basename out of jniLibs, and on a desktop, where there is no opt/lib to find.

--- a/pyogrio/__init__.py
+++ b/pyogrio/__init__.py
@@ -10,6 +10,93 @@
 except Exception:
     pass
 
+# mobile-forge (iOS): the extensions below link libgdal, which links libproj,
+# through @rpath. flet moves each extension and each dylib into its own
+# framework and leaves a "<name>.fwork" marker holding the app-relative path.
+# Preload them RTLD_GLOBAL first, in dependency order, so every extension binds
+# the one loaded image, following the marker where flet left one. No-op on
+# Android, where DT_NEEDED resolves the .so by basename out of jniLibs, and on
+# desktop, where there is no opt/lib to find.
+try:
+    import ctypes as _mf_ctypes
+    import os as _mf_os
+
+    _mf_optlib = _mf_os.path.join(
+        _mf_os.path.dirname(_mf_os.path.dirname(_mf_os.path.abspath(__file__))),
+        "opt",
+        "lib",
+    )
+    for _mf_base in ("libproj", "libgdal"):
+        _mf_dylib = _mf_os.path.join(_mf_optlib, _mf_base + ".dylib")
+        if _mf_os.path.exists(_mf_dylib):
+            try:
+                _mf_ctypes.CDLL(_mf_dylib, mode=_mf_ctypes.RTLD_GLOBAL)
+            except OSError:
+                pass
+            continue
+        _mf_fwork = _mf_os.path.join(_mf_optlib, _mf_base + ".fwork")
+        if not _mf_os.path.exists(_mf_fwork):
+            continue
+        _mf_rel = open(_mf_fwork).read().strip()
+        _mf_dir = _mf_optlib
+        for _ in range(12):
+            _mf_dir = _mf_os.path.dirname(_mf_dir)
+            _mf_candidate = _mf_os.path.join(_mf_dir, _mf_rel)
+            if _mf_os.path.exists(_mf_candidate):
+                try:
+                    _mf_ctypes.CDLL(_mf_candidate, mode=_mf_ctypes.RTLD_GLOBAL)
+                except OSError:
+                    pass
+                break
+except Exception:
+    pass
+
+# mobile-forge: point PROJ at whichever database reached this device, so EPSG
+# codes resolve. PROJ reads PROJ_DATA when it creates its first context, which
+# is why this runs before any extension import rather than through an API call.
+# Only set when the app has set neither PROJ_DATA nor PROJ_LIB, so a database
+# the app points at still wins.
+#
+# Two places it can be, because the platforms deliver it differently. On iOS
+# flet-libproj's opt/share/proj is a real directory inside the app. On Android
+# that tree never reaches site-packages at all, so the database travels inside
+# pyproj instead, extracted to disk -- found here WITHOUT importing pyproj,
+# which would be a heavy import and a dependency this package does not have.
+# If pyproj is not installed on Android there is no database, and EPSG codes go
+# on raising, which is the documented state for that combination.
+try:
+    import os as _mf_os2
+
+    if not _mf_os2.environ.get("PROJ_DATA") and not _mf_os2.environ.get("PROJ_LIB"):
+        _mf_roots = [
+            _mf_os2.path.join(
+                _mf_os2.path.dirname(
+                    _mf_os2.path.dirname(_mf_os2.path.abspath(__file__))
+                ),
+                "opt", "share", "proj",
+            )
+        ]
+        try:
+            from importlib.util import find_spec as _mf_find
+
+            _mf_spec = _mf_find("pyproj")
+            if _mf_spec is not None and _mf_spec.origin:
+                _mf_roots.append(
+                    _mf_os2.path.join(
+                        _mf_os2.path.dirname(_mf_spec.origin),
+                        "proj_dir", "share", "proj",
+                    )
+                )
+        except Exception:
+            pass
+        for _mf_root in _mf_roots:
+            if _mf_os2.path.exists(_mf_os2.path.join(_mf_root, "proj.db")):
+                _mf_os2.environ["PROJ_DATA"] = _mf_root
+                _mf_os2.environ["PROJ_LIB"] = _mf_root
+                break
+except Exception:
+    pass
+
 from pyogrio._version import get_versions
 from pyogrio.core import (
     __gdal_geos_version__,
